<% content_for :header_tags do %>
    <%= stylesheet_link_tag "rules.css", :plugin => "mail_tracker", :media => "screen" %>
    <%= stylesheet_link_tag "bootstrap-duration-picker.css", :plugin => "mail_tracker", :media => "screen" %>
    <%= javascript_include_tag "rules.js", :plugin => "mail_tracker", :media => "screen" %>
    <%= javascript_include_tag "bootstrap-duration-picker.js", :plugin => "mail_tracker", :media => "screen" %>
<% end %>

<%= labelled_form_for @user do |f| %>
  <%= render :partial => 'form', :locals => { :f => f } %>
  <% if @user.active? && email_delivery_enabled? && @user != User.current -%>
    <p><label><%= check_box_tag 'send_information', 1, true %> <%= l(:label_send_information) %></label></p>
  <% end -%>
  <p><%= submit_tag l(:button_save) %></p>
<% end %>

<hr/>

<%
  @rules = MailTrackingRule.where(login_name: @user.id).order(:created_at)
  rule_error = session.delete(:mail_tracking_rule_error)
  if rule_error.present?
    if rule_error['id'] == 'new'
      pending_new_rule = MailTrackingRule.new(login_name: @user.id)
      pending_new_rule.assign_attributes(rule_error['values'])
      pending_new_rule.valid?
    else
      failed_rule = @rules.detect { |r| r.id.to_s == rule_error['id'] }
      if failed_rule
        failed_rule.assign_attributes(rule_error['values'])
        failed_rule.valid?
      end
    end
  end
%>
<div class="mail_tracker_rules">
<h3> 
  Mail tracker rules:
  <button class="btn btn-info" style="margin-left:10px; height: 32px;" id="add_rule">+ Add rule</button>
</h3>

  <% @rules.each do |rule| %>
    <%= render partial: 'mail_tracking_rules/rule_form', locals: { rule: rule, user_id: @user.id } %>
  <% end %>

  <% if pending_new_rule %>
    <%= render partial: 'mail_tracking_rules/rule_form', locals: { rule: pending_new_rule, user_id: @user.id } %>
  <% end %>
</div>

<template id="new_rule_template">
  <%= render partial: 'mail_tracking_rules/rule_form', locals: { rule: MailTrackingRule.new, user_id: @user.id } %>
</template>

<div id="mail_tracker_group_modal" class="modal hidden" style="display:none;">
  <h3 class="title">Add group to project</h3>
  <p>
    <label>Group:</label><br/>
    <select id="modal_group_select" class="form-control">
      <% Group.givable.order(:lastname).each do |group| %>
        <option value="<%= group.id %>"><%= group.lastname %></option>
      <% end %>
    </select>
  </p>
  <p>
    <label>Role to grant on this project:</label><br/>
    <select id="modal_role_select" class="form-control">
      <% Role.where(assignable: true).sorted.each do |role| %>
        <option value="<%= role.id %>"><%= role.name %></option>
      <% end %>
    </select>
  </p>
  <p>
    <button type="button" class="btn btn-success" id="modal_add_group_btn">Add</button>
  </p>
</div>